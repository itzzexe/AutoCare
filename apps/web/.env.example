# AutoCare IQ — configuration reference. NO real secrets in this file.
# Local development: run `pnpm env:init` to create .env.local with fresh random keys.
# Production: inject these from the secret manager (see docs/DEPLOYMENT.md); never commit them.
# Never put secrets in NEXT_PUBLIC_* variables — they are inlined into the browser bundle.

# --- environment ---------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_ORIGIN=http://localhost:3000    # must be https:// in production
CORS_ALLOWED_ORIGINS=               # extra web origins allowed to call the API (comma separated)
TRUSTED_PROXY_HOPS=0                # 1 behind the Caddy reverse proxy in production
HSTS_ENABLED=false                  # enable only after HTTPS on the domain is verified
LOG_LEVEL=info

# --- data stores -----------------------------------------------------------------
# Empty DATABASE_URL = embedded PGlite (dev/test only; refused in production).
DATABASE_URL=                        # app role (DML only), e.g. postgres://autocare_app:...@db:5432/autocare
DATABASE_MIGRATION_URL=              # owner role used by `pnpm db:migrate`
PGLITE_DIR=.data/pglite
REDIS_URL=                           # required in production (shared rate limits)

# --- secrets (generate with `pnpm env:init`; >= 32 random bytes, base64) ---------
CSRF_SECRET=
FILE_URL_SECRET=
DATA_ENCRYPTION_KEYS=                # keyId:base64key[,keyId2:base64key2]  (AES-256-GCM, 32-byte keys)
DATA_ENCRYPTION_ACTIVE_KEY_ID=

# --- sessions --------------------------------------------------------------------
SESSION_IDLE_MINUTES=4320            # 3 days sliding
SESSION_ABSOLUTE_HOURS=720           # 30 days hard cap
ADMIN_SESSION_IDLE_MINUTES=30        # privileged roles
ADMIN_SESSION_ABSOLUTE_HOURS=12
REAUTH_WINDOW_MINUTES=10

# --- local AI (no cloud fallback exists) -----------------------------------------
AI_MODE=local_only                   # local_only | disabled
OLLAMA_URL=http://127.0.0.1:11434    # must be loopback/private network
AI_MODEL=qwen3:8b
AI_EMBED_MODEL=bge-m3
AI_TIMEOUT_MS=90000
AI_MAX_CONCURRENCY=1
AI_MAX_QUEUE=8
AI_NUM_CTX=8192
AI_MAX_OUTPUT_TOKENS=1200
AI_DAILY_QUOTA_PER_USER=30

# --- data providers (server-side only) -------------------------------------------
PROVIDER_NHTSA_ENABLED=true          # public US gov API, no key
PROVIDER_CARSXE_API_KEY=             # requires a recorded licence policy before display is allowed
PROVIDER_AUTODATA_CLIENT_ID=         # contract-only; adapter not implemented until docs/contract available
PROVIDER_AUTODATA_CLIENT_SECRET=
PROVIDER_TECRMI_API_KEY=
PROVIDER_TECALLIANCE_CN_API_KEY=
ENABLE_MOCK_PROVIDERS=false          # test fixtures; refused in production
ALLOW_DEMO_SEED=false                # `pnpm db:seed:demo`; refused in production

# --- files -------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/uploads      # private, outside the web root
UPLOAD_MAX_BYTES=8388608
CLAMAV_HOST=                         # without a scanner, uploads stay quarantined
CLAMAV_PORT=3310

# --- integrations not configured yet -------------------------------------------------
EMAIL_PROVIDER=none                  # messages are recorded in the outbox, not sent
PAYMENT_TEST_WEBHOOK_SECRET=         # test-mode gateway only; no real payments

# --- Payment gateways (docs/PAYMENTS.md). Leave empty = rail switched off. ---
# Qi Card: production host is issued by the acquirer. Sandbox host is refused in production.
QI_API_BASE=
QI_USERNAME=
QI_PASSWORD=
QI_TERMINAL_ID=
QI_WEBHOOK_PUBLIC_KEY=               # PEM from Qi support; verifies webhook X-Signature
# ZainCash v1 (confirm with ZainCash that v1 is still offered before enabling).
ZAINCASH_ENV=test                    # test | live (must be live in production)
ZAINCASH_MERCHANT_ID=
ZAINCASH_SECRET=
ZAINCASH_MSISDN=                     # merchant wallet, 964XXXXXXXXXX

# --- Search engines ---
INDEXING_ENABLED=false               # true only once the domain and legal texts are final

# --- PDF rendering -------------------------------------------------------------------
PDF_BROWSER_EXECUTABLE=              # e.g. /usr/bin/chromium in the container
PDF_BROWSER_CHANNEL=                 # e.g. msedge on Windows dev machines
